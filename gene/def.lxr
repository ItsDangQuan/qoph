# 1. Trivia
skip rule Whitespace = r"[ \t\n\r]+";
skip rule Comment = r"#[^\n]*";

# 2. Keywords
rule StateKw = r"%state";
rule LetKw = r"let";
rule RuleKw = r"rule";
rule SkipKw = r"skip";

# 3. Punctuation
rule Assign = r"=";
rule Semi = r";";
rule FatArrow = r"=>";

# 4. Identifiers & Paths
let ident = r"[a-zA-Z_][a-zA-Z0-9_]*";
rule Identifier = r"{ident}";
rule Path = r"{ident}(::{ident})+";

# 5. Context-Sensitive Payloads
rule RawRegex = r#"r#*""# c#"
    let hash_count = slice.len() - 2; 
    let mut search_offset = self.cursor;
    let final_token;
    
    loop {
        let window = &self.input[search_offset..];
        match window.find('"') {
            Some(quote_rel_idx) => {
                let quote_abs_idx = search_offset + quote_rel_idx;
                let hash_start = quote_abs_idx + 1;
                let hash_end = hash_start + hash_count;

                if hash_end <= self.input.len()
                    && self.input[hash_start..hash_end].bytes().all(|b| b == b'#')
                {
                    self.cursor = hash_end;
                    final_token = Token::RawRegex;
                    break;
                }
                search_offset = quote_abs_idx + 1;
            }
            None => {
                self.cursor = self.input.len();
                return Some(Err(()));
            }
        }
    }
    final_token
"#;
