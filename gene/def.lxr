# 1. Trivia
skip rule Whitespace = r"[ \t\n\r]+";
skip rule Comment = r"#[^\n]*";

# 2. Keywords
rule StateKw = r"%state";
rule LetKw = r"let";
rule RuleKw = r"rule";
rule SkipKw = r"skip";

# 3. Punctuation
rule Assign = r"=";
rule Semi = r";";
rule FatArrow = r"=>";

# 4. Identifiers & Paths
let ident = r"[a-zA-Z_][a-zA-Z0-9_]*";
rule Identifier = r"{ident}";
rule Path = r"{ident}(::{ident})+";

# 5. Context-Sensitive Payloads
rule RawRegex = r#"r#*""# => crate::lexer::rule::handlers::handle_raw_regex;
